###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Ensure consistent line endings for F# and config files
*.fs    text eol=lf diff=fsharp
*.fsi   text eol=lf diff=fsharp
*.fsx   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.config text eol=lf

# Windows-specific
*.bat   text eol=crlf

###############################################################################
# Set the merge driver for project files (optional)
#
# Uncomment if you have frequent merge conflicts in project files
###############################################################################
#*.fsproj    merge=binary
#*.sln       merge=binary

###############################################################################
# Linguist attributes for GitHub
#
# Control how GitHub classifies files (languages, docs, examples, etc.)
###############################################################################
# F# files
*.fsproj    linguist-generated=true linguist-language=F#
*.sln       linguist-generated=true

# Documentation
*.md        linguist-language=Markdown
README.md   linguist-documentation=false
LICENSE.txt     linguist-documentation
CONTRIBUTING.md linguist-documentation
CODE_OF_CONDUCT.md linguist-documentation
CHANGELOG.md linguist-documentation

# Folders
docs/           linguist-documentation
examples/       linguist-example
.github/        linguist-generated

# Logs, temp files — exclude from archive
*.log       export-ignore
*.tmp       export-ignore
artifacts/  export-ignore
bin/        export-ignore
obj/        export-ignore
TestResults/    export-ignore
coveragereport/ export-ignore

###############################################################################
# Binary files (default)
# Images, archives, etc. — treated as binary
###############################################################################
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.dll   binary
*.exe   binary
*.zip   binary
*.tar.gz binary
*.nupkg binary

###############################################################################
# Text conversion for diff (command line only)
# Useful for diffing binary documents as text
###############################################################################
*.pdf   diff=astextplain
*.docx  diff=astextplain
*.xlsx  diff=astextplain
