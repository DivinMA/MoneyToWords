# .editorconfig
# Единые правила форматирования для F# проекта

root = true

# Общие настройки для всех текстовых файлов
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# F# — основной язык
[*.fs]
indent_style = space
indent_size = 4
end_of_line = lf

[*.fsx]
indent_style = space
indent_size = 4
end_of_line = lf

[*.fsi]
indent_style = space
indent_size = 4
end_of_line = lf

# Конфигурационные файлы
[*.json]
indent_style = space
indent_size = 2
end_of_line = lf

[*.yml]
indent_style = space
indent_size = 2
end_of_line = lf

[*.yaml]
indent_style = space
indent_size = 2
end_of_line = lf

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Файлы проекта .NET — CRLF (ожидаются Visual Studio)
[*.fsproj]
end_of_line = crlf

[*.sln]
end_of_line = crlf

[*.config]
end_of_line = crlf

# Документация
[*.md]
end_of_line = lf
trim_trailing_whitespace = false  # Markdown чувствителен к пробелам в конце