<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Основное -->
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateProgramFile>false</GenerateProgramFile>

        <!-- Не генерировать warnings как ошибки -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- Тестовые модули -->
        <Compile Include="Domain\MoneyErrorTests.fs" />
        <Compile Include="Domain\MoneyValidationTests.fs" />
        <Compile Include="Application\DeclensionTests.fs" />
        <Compile Include="Infrastructure\RussianRulesTests.fs" />
        <Compile Include="Infrastructure\TextOutputTests.fs" />
        <Compile Include="Integration\MoneyToWordsTests.fs" />
        <Compile Include="Integration\LargeNumbersTests.fs" />
        <Compile Include="Properties\PropertyTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Зависимости -->
        <PackageReference Include="FsCheck" Version="3.3.2" />
        <PackageReference Include="FsCheck.Xunit" Version="3.3.2" />
        <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="Unquote" Version="7.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Ссылка на основную библиотеку -->
        <ProjectReference Include="..\..\src\MoneyToWords\MoneyToWords.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Автоматическое открытие Xunit -->
        <Using Include="Xunit" />
    </ItemGroup>

</Project>