<Project>
    <!-- ================================================================= -->
    <!-- CENTRALIZED BUILD CONFIGURATION -->
    <!-- Directory.Build.props — применяется ко всем проектам -->
    <!-- ================================================================= -->

    <!-- Корень репозитория -->
    <PropertyGroup>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 1. КОНФИГУРАЦИЯ ПО УМОЛЧАНИЮ (должна быть ВСЕГДА первой!) -->
    <!-- ================================================================= -->
    <PropertyGroup>
        <!-- Гарантируем, что Configuration установлен ДО использования в путях -->
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
        <Configuration Condition="'$(GITHUB_ACTIONS)' == 'true'">Release</Configuration>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 2. ОСНОВНЫЕ НАСТРОЙКИ (общие для всех) -->
    <!-- ================================================================= -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 3. МЕТАДАННЫЕ (общие, НО НЕ ПАКУЕМЫЕ) -->
    <!-- ================================================================= -->
    <PropertyGroup>
        <Authors>Divin MA</Authors>
        <Company>Divin MA</Company>
        <Copyright>© 2026 Divin MA</Copyright>
        <Description>Converts monetary amount to words in Russian. DDD, functional, extensible, localization-ready.</Description>
        <RepositoryUrl>https://github.com/DivinMA/MoneyToWords</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 4. ОПЦИИ СБОРКИ -->
    <!-- ================================================================= -->
    <PropertyGroup>
        <Optimize>true</Optimize>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591;1592;1594;1595;1573;NU1603</NoWarn>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <TreatWarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Отключаем RestoreLockedMode в CI -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <RestoreLockedMode>false</RestoreLockedMode>
    </PropertyGroup>

    <!-- Всегда отключаем FallbackFolder -->
    <PropertyGroup>
        <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 5. ПУТИ -->
    <!-- ================================================================= -->
    <PropertyGroup>
        <BaseOutputPath>$(RepoRoot)bin\</BaseOutputPath> <!--убрал $(Configuration)\-->
        <BaseIntermediateOutputPath>$(RepoRoot)obj\$(MSBuildProjectName)_$(TargetFramework)\</BaseIntermediateOutputPath>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 6. ПАКЕТ — ТОЛЬКО ДЛЯ ОСНОВНОЙ БИБЛИОТЕКИ -->
    <!-- ================================================================= -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MoneyToWords'">
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>MoneyToWordsFSharpLib</PackageId>
        <Product>MoneyToWords</Product>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>fsharp;money;spellout;ddd;localization;ru;currency;number-to-words</PackageTags>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedAllSources>true</EmbedAllSources>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 7. РЕСУРСЫ В ПАКЕТ — ТОЛЬКО ДЛЯ ОСНОВНОЙ БИБЛИОТЕКИ -->
    <!-- ================================================================= -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'MoneyToWords'">
        <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
        <None Include="$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="\" />
        <None Include="$(RepoRoot)LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="$(RepoRoot)icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- ================================================================= -->
    <!-- 8. SOURCE LINK — ТОЛЬКО ДЛЯ ПАКУЕМЫХ ПРОЕКТОВ -->
    <!-- ================================================================= -->
    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
    </ItemGroup>

    <!-- ================================================================= -->
    <!-- 9. MINVER — ТОЛЬКО ДЛЯ ПАКУЕМОГО ПРОЕКТА В RELEASE -->
    <!-- ================================================================= -->
    <ItemGroup Condition="'$(IsPackable)' == 'true' AND '$(Configuration)' == 'Release'">
        <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerDefaultPreReleaseIdentifiers>alpha</MinVerDefaultPreReleaseIdentifiers>
        <MinVerMinimumMajorMinor>1.1</MinVerMinimumMajorMinor>
    </PropertyGroup>

    <!-- ================================================================= -->
    <!-- 10. ДИАГНОСТИКА -->
    <!-- ================================================================= -->
    <Target Name="LogPackagingInfo" BeforeTargets="Build;Pack" Condition="'$(IsPackable)' == 'true'">
        <Message Text="📦 RepoRoot: $(RepoRoot)" Importance="high" />
        <Message Text="📁 Output: $(BaseOutputPath)" Importance="high" />
        <Message Text="🔖 Version: $(MinVerVersion)" Importance="high" />
    </Target>

    <!-- ================================================================= -->
    <!-- 11. ОТКЛЮЧЕНИЕ NU1403 ДЛЯ FSharp.Core -->
    <!-- ================================================================= -->
    <ItemGroup>
        <PackageReference Update="FSharp.Core" NoWarn="NU1403" />
    </ItemGroup>

    <!-- ================================================================= -->
    <!-- 13. ОЧИСТКА FSharp.Core ПЕРЕД RESTORE -->
    <!-- ================================================================= -->
    <Target Name="CleanFSharpCoreBeforeRestore" BeforeTargets="Restore">
        <RemoveDir Directories="$(NuGetPackageFolders)fsharp.core" />
        <Message Text="🧹 Cleaned FSharp.Core from $(NuGetPackageFolders)fsharp.core" Importance="high" />
    </Target>

    <!-- ================================================================= -->
    <!-- 12. CI METADATA (GitHub Actions) -->
    <!-- ================================================================= -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <RepositoryBranch>$([System.Environment]::GetEnvironmentVariable("GITHUB_REF_NAME"))</RepositoryBranch>
        <RepositoryCommit>$([System.Environment]::GetEnvironmentVariable("GITHUB_SHA"))</RepositoryCommit>
    </PropertyGroup>
</Project>
