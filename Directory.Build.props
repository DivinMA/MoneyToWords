<Project>
  <!-- ================================================================= -->
  <!-- CENTRALIZED BUILD CONFIGURATION -->
  <!-- Directory.Build.props — применяется ко всем проектам в репозитории -->
  <!-- ================================================================= -->

  <!-- Корень репозитория -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>
    <RepoRoot Condition="!HasTrailingSlash('$(RepoRoot)')">$(RepoRoot)\</RepoRoot>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 1. ОСНОВНЫЕ НАСТРОЙКИ -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 2. МЕТАДАННЫЕ ПАКЕТА -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <PackageId>MoneyToWordsFSharpLib</PackageId>
    <Product>MoneyToWords</Product>
    <Authors>Divin MA</Authors>
    <Company>Divin MA</Company>
    <Copyright>© 2026 Divin MA</Copyright>
    <Description>Converts monetary amount to words in Russian. DDD, functional, extensible, localization-ready.</Description>
    <PackageProjectUrl>https://github.com/DivinMA/MoneyToWords</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DivinMA/MoneyToWords</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>fsharp;money;spellout;ddd;localization;ru;currency;number-to-words</PackageTags>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 3. ОПЦИИ СБОРКИ И УПАКОВКИ -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedAllSources>true</EmbedAllSources>
    <IncludeSymbols>false</IncludeSymbols>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 4. ПУТИ -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <BaseOutputPath>$(RepoRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 5. ПРЕДУПРЕЖДЕНИЯ -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);1591;1592;1594;1595;1573</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 6. РЕСУРСЫ В ПАКЕТЕ -->
  <!-- ================================================================= -->
  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- ================================================================= -->
  <!-- 7. SOURCE LINK -->
  <!-- ================================================================= -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
  </ItemGroup>

  <!-- ================================================================= -->
  <!-- 8. MINVER — АВТОВЕРСИОНИРОВАНИЕ -->
  <!-- ================================================================= -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- ================================================================= -->
  <!-- 9. ДИАГНОСТИКА -->
  <!-- ================================================================= -->
  <Target Name="LogPackagingInfo" BeforeTargets="Build;Pack">
    <Message Text="📦 RepoRoot: $(RepoRoot)" Importance="high" />
    <Message Text="📁 Output: $(BaseOutputPath)" Importance="high" />
    <Message Text="🔖 Version: $(MinVerVersion)" Importance="high" />
  </Target>
</Project>