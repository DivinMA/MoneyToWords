{
  "extends": [ "@commitlint/config-conventional" ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "build",
        "ci",
        "docs",
        "feat",
        "fix",
        "perf",
        "refactor",
        "test",
        "chore",
        "style",
        "revert"
      ]
    ],
    "scope-empty": [ 2, "never" ],
    "subject-case": [ 0 ],
    "subject-empty": [ 2, "never" ],
    "subject-full-stop": [ 0, "never" ],
    "header-max-length": [ 0 ]
  }
}
